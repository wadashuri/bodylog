{
  "expo": {
    "name": "筋トレ写真と体重 - 体の変化を記録",
    "slug": "bodylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.slaboratory.bodylog.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "体型の写真を撮影するためにカメラを使用します。"
        }
      ]
    ],
    "scheme": "bodylog",
    "platforms": ["ios"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1494d637-1be2-4830-9478-52f05c5f6c97"
      }
    },
    "owner": "shuri0108"
  }
}
