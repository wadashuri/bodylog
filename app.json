{
  "expo": {
    "name": "筋トレ体重記録",
    "slug": "bodylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.slaboratory.bodylog",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "bodylog",
    "platforms": [
      "ios"
    ]
  }
}
